sudo bash -c '
set -e

OS=$(/usr/bin/sw_vers -productVersion)

case "$OS" in
  27.0.1) ;;
  *) echo "ERROR: This command is specifically for macOS 27.0.1. Detected: $OS"; exit 1 ;;
esac

DAEMON="/Library/LaunchDaemons/com.nrpcapitals.blockusb.plist"
HELPER="/Library/PrivilegedHelperTools/com.nrpcapitals.blockusb.sh"

cat > "$HELPER" <<'"'"'EOF'"'"'
#!/bin/bash

while true; do
    for disk in $(/usr/sbin/diskutil list external physical 2>/dev/null | \
        /usr/bin/awk "/^\/dev\/disk[0-9]+ / {print \$1}")
    do
        INFO=$(/usr/sbin/diskutil info "$disk" 2>/dev/null)

        if echo "$INFO" | /usr/bin/grep -qE "^[[:space:]]*Protocol:[[:space:]]+USB[[:space:]]*$"; then
            /usr/sbin/diskutil unmountDisk force "$disk" >/dev/null 2>&1
        fi
    done

    /bin/sleep 2
done
EOF

chmod 755 "$HELPER"
chown root:wheel "$HELPER"

cat > "$DAEMON" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <key>Label</key>
    <string>com.nrpcapitals.blockusb</string>

    <key>ProgramArguments</key>
    <array>
        <string>$HELPER</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

</dict>
</plist>
EOF

chmod 644 "$DAEMON"
chown root:wheel "$DAEMON"

launchctl bootout system "$DAEMON" 2>/dev/null || true
launchctl bootstrap system "$DAEMON"

if launchctl print system/com.nrpcapitals.blockusb >/dev/null 2>&1; then
    echo ""
    echo "======================================"
    echo " USB STORAGE BLOCK: ACTIVE"
    echo " macOS: $OS"
    echo "======================================"
    echo ""
    echo "Insert your TEST USB drive."
else
    echo "ERROR: USB blocking service failed to start."
    exit 1
fi
'
